<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GREY Puzzle AI (On-Device)"
            android:textColor="#38BDF8"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Otak AI via API Key + Auto-Touch Accessibility di HP"
            android:textColor="#A3A3A3"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Gemini API Key"
            android:textColor="#E5E5E5"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#171717"
            android:hint="AIzaSy..."
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#737373" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Model Gemini"
            android:textColor="#E5E5E5"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#171717"
            android:hint="gemini-2.5-flash"
            android:padding="12dp"
            android:text="gemini-2.5-flash"
            android:textColor="#FFFFFF"
            android:textColorHint="#737373" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Kalibrasi Area Papan Grid (x1,y1,x2,y2,rows,cols)"
            android:textColor="#E5E5E5"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBoardBbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#171717"
            android:padding="12dp"
            android:text="0.02,0.14,0.98,0.78,8,8"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Simpan Pengaturan" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2. Aktifkan Accessibility Service" />

        <Button
            android:id="@+id/btnOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3. Izinkan Tombol Melayang (Overlay)" />

        <Button
            android:id="@+id/btnLaunchOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="4. Tampilkan Kontrol Melayang di Game" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#0F172A"
            android:padding="12dp"
            android:text="Status: Menunggu konfigurasi."
            android:textColor="#38BDF8"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
